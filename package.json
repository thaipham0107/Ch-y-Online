{
  "name": "chay-online",
  "version": "1.2.0",
  "description": "Chạy Online - game chạy bộ nhiều người chơi, kết nối Strava, sức mạnh = số km",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "demo": "node tools/demo.mjs",
    "check:strava": "node tools/check-strava.mjs",
    "courses:build": "node tools/build-courses.mjs",
    "courses:gpx": "node tools/import-gpx.mjs",
    "build:worker": "node scripts/build-assets.mjs",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "smoke": "node tools/smoke.mjs",
    "doctor": "node tools/doctor.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "three": "^0.170.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
