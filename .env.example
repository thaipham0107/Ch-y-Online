PORT=3000
# URL công khai của game (dùng cho redirect Strava). Ví dụ: https://chay.example.com
BASE_URL=http://localhost:3000
# Tạo app tại https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Quyền xin từ Strava. Dùng activity:read_all nếu muốn tính cả hoạt động "Chỉ mình tôi"
STRAVA_SCOPE=read,activity:read
# Đặt 1 để chạy thử với dữ liệu Strava GIẢ (không cần key)
STRAVA_MOCK=0
# Bản đồ cho chế độ GPS (mặc định dùng dịch vụ công cộng, có giới hạn sử dụng)
# TILES_ROAD=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILES_SAT=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# GEO_SEARCH_URL=https://nominatim.openstreetmap.org
# GEO_ROUTE_URL=https://valhalla1.openstreetmap.de
