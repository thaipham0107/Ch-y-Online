PORT=3000
# URL công khai của game (dùng cho redirect Strava). Ví dụ: https://chay.example.com
BASE_URL=http://localhost:3000
# Tạo app tại https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Quyền xin từ Strava. Dùng activity:read_all nếu muốn tính cả hoạt động "Chỉ mình tôi"
STRAVA_SCOPE=read,activity:read
# Đặt 1 để chạy thử với dữ liệu Strava GIẢ (không cần key)
STRAVA_MOCK=0
